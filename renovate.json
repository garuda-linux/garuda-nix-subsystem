{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "FireDragon v13 releases",
      "managerFilePatterns": [
        "/packages/firedragon-bin/version\\.json$/",
        "/packages/firedragon-catppuccin-bin/version\\.json$/"
      ],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "gitlab-releases",
      "packageNameTemplate": "garuda-linux/firedragon/firedragon13",
      "registryUrlTemplate": "https://gitlab.com",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "BeautyLine icon theme",
      "managerFilePatterns": ["/packages/beautyline-icons/version\\.json$/"],
      "matchStrings": ["\"rev\"\\s*:\\s*\"(?<currentDigest>[0-9a-f]{40})\""],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "beautyline-icons",
      "packageNameTemplate": "https://gitlab.com/garuda-linux/themes-and-settings/artwork/beautyline",
      "currentValueTemplate": "master"
    },
    {
      "customType": "regex",
      "description": "Dr460nized KDE theme",
      "managerFilePatterns": [
        "/packages/dr460nized-kde-theme/version\\.json$/"
      ],
      "matchStrings": ["\"rev\"\\s*:\\s*\"(?<currentDigest>[0-9a-f]{40})\""],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "dr460nized-kde-theme",
      "packageNameTemplate": "https://gitlab.com/garuda-linux/themes-and-settings/settings/garuda-dr460nized",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "description": "Recompute nix hashes/URLs",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["packages/*/version.json"],
      "postUpgradeTasks": {
        "executionMode": "branch",
        "fileFilters": ["packages/*/version.json"],
        "commands": ["bash packages/update-hashes.sh {{{packageFile}}}"]
      }
    }
  ]
}
